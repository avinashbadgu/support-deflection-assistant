OPENAI_API_KEY=sk-...

# Models
SA_EMBED_MODEL=text-embedding-3-small
SA_GEN_MODEL=gpt-4o-mini
SA_JUDGE_MODEL=gpt-4o-mini

# Paths
SA_DATA_DIR=./data

# Retrieval — placeholders until eval (M2) measures them
SA_CHUNK_SIZE=1000
SA_CHUNK_OVERLAP=200
SA_TOP_K=8
SA_RERANK_TOP_N=5

# Retrieval mode (M8). Hybrid = BM25 + dense fused with RRF.
SA_USE_HYBRID=false
SA_BM25_TOP_K=20
SA_RRF_K=60

# Toggles for the deliberate-improvement A/B (M4, M9)
SA_USE_RERANKER=true
# "llm" | "crossencoder" | "none". Cross-encoder requires the [crossencoder] extra.
SA_RERANKER_KIND=llm
SA_CROSSENCODER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
SA_USE_CACHE=true

# Abstention (M3). DO NOT trust these defaults — pick from the M3 sweep output.
SA_ABSTAIN_MIN_SCORE=0.35
SA_ABSTAIN_USE_JUDGE=true

# Cache (M6 optimization)
SA_CACHE_SIMILARITY=0.97
SA_CACHE_TTL_SECONDS=3600
